# ==============================================================================
# Fêrbe — Production & Development Environment Variables Template
# Copy this file to .env.local for local development.
# On Cloudflare Pages or Vercel, set these in the dashboard under Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database & Backend (Convex Cloud)
# ------------------------------------------------------------------------------
# Your Convex Cloud deployment URL (from dashboard.convex.dev)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Optional: HTTP actions URL (for webhooks or file streaming)
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# CI/CD & Deploy CLI key (from Convex Dashboard -> Settings -> Deploy Keys)
# Required to deploy schema & functions from terminal or GitHub Actions: `npx convex deploy`
CONVEX_DEPLOY_KEY=prod:your-project-slug|...

# ------------------------------------------------------------------------------
# 2. Authentication (Clerk)
# ------------------------------------------------------------------------------
# Publishable key (Client-side, visible to browser)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Secret key (Server-side only, used by middleware)
CLERK_SECRET_KEY=sk_test_...

# Standard Clerk URL routing paths
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/learn
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/learn

# ------------------------------------------------------------------------------
# 3. Convex Dashboard Variables (Configure in Convex Dashboard -> Settings -> Env)
# ------------------------------------------------------------------------------
# CLERK_JWT_ISSUER_DOMAIN: From Clerk Dashboard -> JWT Templates -> Convex -> Issuer URL
# e.g. https://your-clerk-app.clerk.accounts.dev
# ADMIN_SEED_SECRET: A secret passphrase you choose to authorize curriculum seeding

# ------------------------------------------------------------------------------
# 4. Hosting (Cloudflare Pages)
# ------------------------------------------------------------------------------
# Next.js 16 requires Node 20.9+. Cloudflare defaults to Node 18 unless specified.
NODE_VERSION=20
