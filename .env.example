# ---- Frontend (build-time, inlined into the client bundle) ----
# Convex deployment URL. From: `npx convex dev` output or the Convex dashboard.
NEXT_PUBLIC_CONVEX_URL=https://your-convex-deployment.convex.cloud

# Clerk publishable key. From: Clerk dashboard -> API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# ---- Convex deployment environment variables (set in the Convex dashboard) ----
# CLERK_JWT_ISSUER_DOMAIN: issuer of the Clerk "convex" JWT template,
# e.g. https://your-app.clerk.accounts.dev
# ADMIN_SEED_SECRET: strong random secret required by `npm run seed`
# (no default — seeding refuses to run without it)

# ---- Local dev-only convenience (not used in production) ----
# CLERK_SECRET_KEY is not referenced by any application code today; only set it
# if you add server-side Clerk integrations.
# CLERK_SECRET_KEY=sk_test_...

# ---- Scripts ----
# TTS service used by scripts/generate-kurdish-audio.ts (not part of the app)
TTS_SERVICE_URL=http://localhost:8000/api/tts
